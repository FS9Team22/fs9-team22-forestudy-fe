import { useState, useEffect } from 'react';
import { getHabitListByStudyId, updateHabit } from '@/api/HabitService.js';
import { getStudyById } from '@/api/StudyService.js';

const API_URL = import.meta.env.VITE_API_URL || 'http://localhost:3001';

export function useHabits(studyId) {
  const [goalList, setGoalList] = useState([]);
  const [study, setStudy] = useState([]);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState(null);

  const fetchHabits = async () => {
    if (!studyId) return null;
    try {
      setIsLoading(true);
      const [studyData, habitData] = await Promise.all([
        getStudyById({ id: studyId }),
        getHabitListByStudyId({ studyId }),
      ]);
      setStudy(studyData.data);
      setGoalList(habitData.data);
    } catch (error) {
      console.error('습관 조회 실패:', error);
      setError(error);
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    fetchHabits();
  }, [studyId]);

  const handleGoalStatusChange = async (id) => {
    try {
      // ui를 먼저 변경하고 API 호출
      setGoalList((prevList) =>
        prevList.map((goal) =>
          goal.id === id ? { ...goal, isDone: !goal.isDone } : goal,
        ),
      );

      const response = await fetch(`${API_URL}/${studyId}/habit/${id}/status`, {
        method: 'PATCH',
      });

      if (!response.ok) {
        fetchHabits();
      }
    } catch (error) {
      console.error('상태 변경 실패', error);
      fetchHabits();
    }
  };

  const saveHabitList = async (newList) => {
    try {
      const data = await updateHabit(studyId, newList);
      console.log(data)
      if (data.success) {
        setGoalList(data.data);
      }
    } catch (error) {
      console.error('저장 실패:', error);
    }
  };

  return {
    goalList,
    study,
    isLoading,
    error,
    handleGoalStatusChange,
    saveHabitList,
  };
}

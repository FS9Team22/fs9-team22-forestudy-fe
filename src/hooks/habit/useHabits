import { useState, useEffect, useCallback } from 'react';

const API_URL = import.meta.env.VITE_API_URL || 'http://localhost:3001';

export function useHabits(studyId) {
  const [goalList, setGoalList] = useState([]);
  const [isLoading, setIsLoading] = useState(true);

  const fetchHabits = useCallback(async () => {
    try {
      setIsLoading(true);
      const response = await fetch(`${API_URL}/study/${studyId}/habits`);
      const data = await response.json();

      if (data.success) {
        setGoalList(data.data);
      }
    } catch (error) {
      console.error('습관 조회 실패:', error);
    } finally {
      setIsLoading(false);
    }
  }, [studyId]);

  useEffect(() => {
    fetchHabits();
  }, [fetchHabits]);

  const handleGoalStatusChange = async (id) => {
    try {
      // ui를 먼저 변경하고 API 호출
      setGoalList((prevList) =>
        prevList.map((goal) =>
          goal.id === id ? { ...goal, isDone: !goal.isDone } : goal,
        ),
      );

      const response = await fetch(
        `${API_URL}/study/${studyId}/habits/${id}/status`,
        { method: 'PATCH' },
      );

      if (!response.ok) {
        fetchHabits();
      }
    } catch (error) {
      console.error('상태 변경 실패', error);
      fetchHabits();
    }
  };

  const saveHabitList = async (originList, newList) => {
    try {
      const deletedGoals = originList.filter(
        (goal) => !newList.find((edit) => edit.id === goal.id),
      );

      for (const goal of deletedGoals) {
        await fetch(`${API_URL}/study/${studyId}/habits/${goal.id}`, {
          method: 'DELETE',
        });
      }

      for (const goal of originList) {
        const originalGoal = goalList.find((g) => g.id === goal.id);

        if (!originalGoal) {
          await fetch(`${API_URL}/study/${studyId}/habits`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ text: goal.text }),
          });
        } else if (originalGoal.text !== goal.text) {
          await fetch(`${API_URL}/study/${studyId}/habits/${goal.id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ text: goal.text }),
          });
        }
      }

      const response = await fetch(`${API_URL}/study/${studyId}/habits`);
      const data = await response.json();

      if (data.success) {
        setGoalList(data.data);
      }

      setIsModalOpen(false);
    } catch (error) {
      console.error('저장 실패:', error);
    }
  };

  return {
    goalList,
    isLoading,
    handleGoalStatusChange,
    saveHabitList,
  };
}
